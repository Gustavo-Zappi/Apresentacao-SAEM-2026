# Supabase (Project Settings > API). Sem estas variáveis o app roda em MODO LOCAL
# (palco e plateia sincronizam entre abas do mesmo navegador, ideal para ensaio).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon

# URL pública que vai no QR code (domínio do deploy). Se vazio, usa a origem atual.
VITE_PUBLIC_URL=https://saem2026.vercel.app
